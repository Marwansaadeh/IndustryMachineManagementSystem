<h3>MachineList</h3>
<div class="machine-list-card">

    <!-- Header -->
    <div class="machine-list-header">

        <div>
            <h2 class="machine-list-title">
                List of Machines
            </h2>

            <p class="machine-list-subtitle">
                Monitor and manage your machines
            </p>
        </div>

        <button class="add-machine-button"
                @onclick="Actions.CreateMachineAsync.InvokeAsync">

            <i class="bi bi-plus-lg"></i>

            Add Machine

        </button>

    </div>


    <!-- Table -->
    <div class="machine-table-container">

        <table class="machine-table">

            <thead>
                <tr>

                    <th>Machine</th>

                    <th>Status</th>

                    <th>Last Data</th>

                    <th>Last Updated</th>

                    <th>Actions</th>

                </tr>
            </thead>


            <tbody>

                @foreach (var machine in Machines)
                {
                    <MachineItem Machine="@machine" Actions="@Actions" />
                }

            </tbody>

        </table>

    </div>

</div>


@code {
    

    [Parameter]
    public IReadOnlyList<Machine> Machines { get; set; } = [];
    [CascadingParameter]
    public MachineActions Actions { get; set; } = null!;
    
}
