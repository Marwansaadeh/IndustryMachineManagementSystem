@page "/"
@page "/dashboard"

<PageTitle>Machine Dashboard</PageTitle>

<div class="dashboard-page">

    <div class="dashboard-header">

        <h1>Machine Dashboard</h1>

        <p>
            Monitor and manage your industrial machines.
        </p>

    </div>


    <div class="dashboard-grid">
        <div class="statistics-section">

            <StatistikPanel />

        </div>

        <div class="machines-section">
            @if (_loading)
            {
                <p>Loading machines...</p>
            }
            else
            {
                <CascadingValue Value="_actions">
                    <MachineList Machines="_machines" />
                </CascadingValue>
            }
            
        </div>

    </div>

</div>
@code {

    private List<MachineDto> _machines = null!;

    private MachineActions _actions = null!;
    private bool _loading = true;


    [Inject]
    public IHttpMachineService HttpClientFactory { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {

        _actions = new MachineActions
        {
            CreateMachineAsync = EventCallback.Factory.Create<CreateMachineDto>(
            this, CreateMachineAsync),

            DeleteMachineAsync = EventCallback.Factory.Create<Guid>(
            this, DeleteMachineAsync),

            StartMachineAsync = EventCallback.Factory.Create<Guid>(
            this, StartMachineAsync),

            StopMachineAsync = EventCallback.Factory.Create<Guid>(
            this, StopMachineAsync),

            UpdateMachineAsync = EventCallback.Factory.Create<UpdateMachineDto>(
            this, UpdateMachineAsync)
        };
        _loading = true;

        try
        {
            _machines = await HttpClientFactory.GetMachinesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    public async Task CreateMachineAsync(CreateMachineDto machine)
    {
        var createdMachine = await HttpClientFactory.CreateMachineAsync(machine);
        _machines.Add(createdMachine);

    }

    public async Task DeleteMachineAsync(Guid id)
    {
        var deletedMachine = await HttpClientFactory.DeleteMachineAsync(id);
        if (deletedMachine)
        {
            try
            {
                _machines = await HttpClientFactory.GetMachinesAsync();
            }
            finally
            {
                _loading = false;
            }
        }
    }

    public async Task<MachineDto> GetMachineByIdAsync(Guid id)
    {
        return await HttpClientFactory.GetMachineByIdAsync(id);
    }

    public async Task<List<MachineDto>> GetMachinesAsync()
    {
        return await HttpClientFactory.GetMachinesAsync();
    }

    public async Task StartMachineAsync(Guid id)
    {
        await HttpClientFactory.StartMachineAsync(id);
        try
        {
            _machines = await HttpClientFactory.GetMachinesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    public async Task StopMachineAsync(Guid id)
    {
        await HttpClientFactory.StopMachineAsync(id);
        try
        {
            _machines = await HttpClientFactory.GetMachinesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    public async Task UpdateMachineAsync(UpdateMachineDto machine)
    {
        await HttpClientFactory.UpdateMachineAsync(machine);
        try
        {
            _machines = await HttpClientFactory.GetMachinesAsync();
        }
        finally
        {
            _loading = false;
        }
    }
   
  
}